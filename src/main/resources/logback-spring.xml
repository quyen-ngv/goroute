<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <!-- 1. Console Appender (JSON format for Prod, Color for Dev) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
        </encoder>
    </appender>

    <!-- 2. Rolling File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${LOG_DIR:-logs}/${appName}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- keep 30 days' worth of history, capped so a chatty day cannot fill the disk -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- PROFILES CONFIGURATION -->

    <!--
         Levels are NOT set here. Spring applies logging.level.* from application.yaml
         after this file has loaded, so a level declared here is silently overridden.
         The com.ds.goroute=DEBUG that used to sit below never took effect. These blocks decide
         only which appenders a profile writes to; LOG_LEVEL decides how much.
    -->

    <!-- Local/Dev: Log to Console (Color) + File -->
    <springProfile name="local,dev,default">
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!--
         Prod/Staging: JSON on stdout (read by the container runtime) plus a rolling
         file under the mounted /app/logs volume. The old Logstash TCP appender
         pointed at localhost:5000 inside the container, where nothing listens, so
         prod logs only ever survived in `docker logs`.
    -->
    <springProfile name="prod,staging">
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

</configuration>
