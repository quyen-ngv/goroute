# Deploy-time secrets for docker-compose.yml.
# Copy to `.env` next to docker-compose.yml on the server and fill every value.
# `.env` is gitignored; never commit real values.
#
# These used to be hardcoded defaults inside docker-compose.yml, which meant the
# production JWT signing key and database passwords were readable by anyone with
# the repo. They are now required: compose refuses to start if one is missing.
#
# IMPORTANT: the values already present in git history are compromised. Rotate
# them. Rotating GOROUTE_JWT_SECRET signs every user out once.

# Postgres for the vocaberry stack
VOCABERRY_DB_PASSWORD=

# Postgres for GoRoute. Must match the password the goroute-db volume was
# initialised with, otherwise the app cannot authenticate.
GOROUTE_DB_PASSWORD=

# HS256 signing key for GoRoute access tokens. At least 43 characters.
GOROUTE_JWT_SECRET=

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
GOROUTE_AWS_ACCESS_KEY_ID=admin
GOROUTE_AWS_SECRET_ACCESS_KEY=

# Optional
GOROUTE_API_KEY=
GOROUTE_LOG_LEVEL=ERROR
# Sign in with Apple audiences, comma separated (iOS bundle id + Service ID).
GOROUTE_APPLE_AUDIENCES=app.ondetour
